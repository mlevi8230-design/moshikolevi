---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const wimm = {
  title: 'WHERE IS MY MIND?',
  subtitle: 'תערוכת יחיד · גלריית מרכב הבמה',
  href: '/art/exhibitions/wimm',
  thumbs: [
    '/images/exhibitions/משקל-המחשבות.jpg',
    '/images/exhibitions/נגן-2.jpg',
    '/images/exhibitions/בין-אחיזה-לנפילה.jpg',
    '/images/exhibitions/התבוננות.jpg',
    '/images/exhibitions/מחוך-1.jpg',
    '/images/exhibitions/ליצן.jpg',
  ],
};

const group = [
  {
    name: 'עוצמת הרכות',
    url: 'https://we-art.co.il/events/%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%aa-%d7%a2%d7%95%d7%a6%d7%9e%d7%aa-%d7%94%d7%a8%d7%9b%d7%95%d7%aa-%d7%9c%d7%a8%d7%92%d7%9c-%d7%97%d7%95%d7%93%d7%a9-%d7%94%d7%90%d7%99%d7%a9%d7%94-%d7%94%d7%91/',
  },
  {
    name: 'תתארו לכם עולם',
    url: 'https://we-art.co.il/events/%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%94-%d7%aa%d7%aa%d7%90%d7%a8%d7%95-%d7%9c%d7%9b%d7%9d-%d7%a2%d7%95%d7%9c%d7%9d-%d7%91%d7%92%d7%9c%d7%a8%d7%99%d7%99%d7%aa-weart/',
  },
  {
    name: 'לשוב הבייתה',
    url: 'https://we-art.co.il/events/%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%aa-%d7%9c%d7%a9%d7%95%d7%91-%d7%94%d7%91%d7%99%d7%99%d7%aa%d7%94-%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%94-%d7%a7%d7%91%d7%95%d7%a6%d7%aa%d7%99%d7%aa/',
  },
  {
    name: 'ריקוד עוף החול',
    url: 'https://we-art.co.il/events/%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%aa-%d7%a8%d7%99%d7%a7%d7%95%d7%93-%d7%a2%d7%95%d7%a3-%d7%94%d7%97%d7%95%d7%9c-%d7%aa%d7%a2%d7%a8%d7%95%d7%9b%d7%94-%d7%a7%d7%91%d7%95%d7%a6%d7%aa%d7%99%d7%aa/',
  },
];
---

<BaseLayout title="תערוכות" description="תערוכות אמנות של מושיקו לוי — WHERE IS MY MIND ותערוכות קבוצתיות">

  <section class="max-w-3xl mx-auto px-6 pt-14 pb-16">
    <h1 class="text-3xl font-bold text-gray-800 mb-2 text-center">תערוכות</h1>
    <p class="text-center text-gray-400 text-sm mb-14">
      בשנים האחרונות זכיתי להציג את עבודותיי בתערוכות יחיד וקבוצתיות
    </p>

    <!-- WHERE IS MY MIND — תערוכת יחיד -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px flex-1 bg-gray-200"></div>
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-widest shrink-0">תערוכת יחיד</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>

      <a href={wimm.href} class="group block border border-gray-200 rounded-2xl overflow-hidden hover:border-[#5ba4a4] hover:shadow-md transition-all">
        <!-- 6 thumbnails -->
        <div class="grid grid-cols-3 gap-px bg-gray-100">
          {wimm.thumbs.map(src => (
            <div class="aspect-square overflow-hidden bg-gray-50">
              <img
                src={src}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          ))}
        </div>
        <!-- כותרת -->
        <div class="p-5 bg-white flex items-center justify-between">
          <div>
            <h2 class="font-bold text-gray-800 text-base mb-0.5">{wimm.title}</h2>
            <p class="text-sm text-gray-400">{wimm.subtitle}</p>
          </div>
          <span class="text-[#5ba4a4] text-sm font-medium group-hover:gap-3 transition-all flex items-center gap-1.5">
            לכל היצירות
            <span class="text-lg leading-none">←</span>
          </span>
        </div>
      </a>
    </div>

    <!-- תערוכות קבוצתיות -->
    <div>
      <div class="flex items-center gap-3 mb-6">
        <div class="h-px flex-1 bg-gray-200"></div>
        <span class="text-xs font-semibold text-gray-400 uppercase tracking-widest shrink-0">תערוכות קבוצתיות</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>

      <div class="space-y-3">
        {group.map(ex => (
          <a
            href={ex.url}
            target="_blank"
            rel="noopener"
            class="group flex items-center justify-between gap-4 p-5 border border-gray-200 rounded-2xl hover:border-[#5ba4a4] hover:shadow-sm transition-all"
          >
            <span class="font-semibold text-gray-700 group-hover:text-[#5ba4a4] transition-colors">{ex.name}</span>
            <span class="text-gray-300 group-hover:text-[#5ba4a4] shrink-0 text-lg transition-colors">←</span>
          </a>
        ))}
      </div>
    </div>

  </section>

</BaseLayout>
