---

<BaseLayout title="WHERE IS MY MIND?" description="תערוכת יחיד — WHERE IS MY MIND, גלריית מרכב הבמה. ציורים ופסלים של מושיקו לוי">

  <section class="max-w-4xl mx-auto px-6 pt-10 pb-16">

    <!-- חזרה -->
    <a href="/art/exhibitions" class="inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-[#5ba4a4] transition-colors mb-8">
      <span>→</span> חזרה לתערוכות
    </a>

    <!-- כותרת -->
    <h1 class="text-3xl font-bold text-gray-800 mb-1 text-center">WHERE IS MY MIND?</h1>
    <p class="text-center text-gray-400 text-sm mb-2">תערוכת יחיד · גלריית מרכב הבמה</p>
    <p class="text-center text-gray-500 text-sm leading-relaxed mb-10 max-w-xl mx-auto">
      חלון אל התודעה של ציייר ופסלת, כאשר המפגש ביניהם מציג את העיסוק האינסופי במוח האדם, המניע אותו ליצור.
      <span class="block text-gray-400 italic mt-1">SO WHERE IS YOUR MIND?</span>
    </p>

    <!-- פוסטר -->
    <div class="flex justify-center mb-12">
      <div class="rounded-xl overflow-hidden shadow-sm" style="max-width: 300px;">
        <img src="/images/exhibitions/wimm-poster.jpg" alt="פוסטר WHERE IS MY MIND" class="w-full" loading="lazy" />
      </div>
    </div>

    <!-- יצירות -->
    <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">יצירות</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 mb-14">
      {artworks.map(art => (
        <div class="group">
          <div class="aspect-[3/4] overflow-hidden rounded-lg bg-gray-50">
            <img
              src={art.src}
              alt={art.title || 'יצירה'}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              loading="lazy"
            />
          </div>
          {art.title && (
            <p class="text-xs text-gray-500 mt-1.5 text-center leading-tight">{art.title}</p>
          )}
        </div>
      ))}
    </div>

    <!-- תמונות חלל -->
    <h2 class="text-sm font-semibold text-gray-400 uppercase tracking-widest mb-4">מחלל התערוכה</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {galleryPhotos.map(src => (
        <div class="rounded-xl overflow-hidden">
          <img
            src={src}
            alt="חלל התערוכה"
            class="w-full object-cover"
            style="height: 180px; object-position: center;"
            loading="lazy"
          />
        </div>
      ))}
    </div>

  </section>

</BaseLayout>
