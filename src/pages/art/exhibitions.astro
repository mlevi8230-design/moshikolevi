  '/images/exhibitions/wimm-gallery-1.jpg',
  '/images/exhibitions/wimm-gallery-2.jpg',
  '/images/exhibitions/wimm-gallery-3.jpg',
  '/images/exhibitions/exhibit-photo-1.jpg',
  '/images/exhibitions/exhibit-photo-2.jpg',
  '/images/exhibitions/exhibit-photo-3.jpg',
