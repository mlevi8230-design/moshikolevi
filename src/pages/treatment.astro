---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="שיטת הטיפול" description="טיפול LI-CBT בגישת ACT — מה זה אומר ואיך זה עובד">

  <section class="max-w-3xl mx-auto px-6 pt-14 pb-12">
    <h1 class="text-3xl font-bold text-gray-800 mb-2 text-center">שיטת הטיפול</h1>
    <p class="text-center text-gray-400 text-sm mb-10">הגישות הטיפוליות שאני עובד איתן</p>

    <!-- 3 כרטיסי שיטה -->
    <div class="space-y-4 mb-12">

      <!-- CBT -->
      <div class="rounded-xl border border-gray-100 bg-gray-50 p-5" style="border-right: 4px solid #5ba4a4;">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-bold text-white rounded-full px-3 py-0.5 shrink-0" style="background:#5ba4a4">CBT</span>
          <h2 class="font-bold text-gray-800 text-base leading-tight">Cognitive Behavior Therapy</h2>
        </div>
        <p class="text-xs text-gray-400 mb-2">טיפול קוגנטיבי-התנהגותי</p>
        <p class="text-gray-600 leading-relaxed text-sm">
          טיפול קצר מועד, ממוקד מטרה, המסייע בזיהוי דפוסי חשיבה והתנהגות בעייתיים ומתן כלים מעשיים לשינוי.
        </p>
      </div>

      <!-- LI -->
      <div class="rounded-xl border border-gray-100 bg-gray-50 p-5" style="border-right: 4px solid #7bb8b8;">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-bold text-white rounded-full px-3 py-0.5 shrink-0" style="background:#7bb8b8">LI</span>
          <h2 class="font-bold text-gray-800 text-base leading-tight">Low Intensity</h2>
        </div>
        <p class="text-xs text-gray-400 mb-2">טיפול בעצימות נמוכה</p>
        <p class="text-gray-600 leading-relaxed text-sm">
          טיפול קצר מועד המתמקד בטווח מוגדר של נושאים — יעיל, נגיש, וממוקד בתוצאות.
        </p>
      </div>

      <!-- ACT -->
      <div class="rounded-xl border border-gray-100 bg-gray-50 p-5" style="border-right: 4px solid #4a8a8a;">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-bold text-white rounded-full px-3 py-0.5 shrink-0" style="background:#4a8a8a">ACT</span>
          <h2 class="font-bold text-gray-800 text-base leading-tight">Acceptance and Commitment Therapy</h2>
        </div>
        <p class="text-xs text-gray-400 mb-2">תרפית קבלה ומחויבות</p>
        <p class="text-gray-600 leading-relaxed text-sm">
          גישה המפתחת גמישות נפשית — היכולת להיות פתוחים ומחוברים למה שחשוב לכם, גם כשיש קושי רגשי.
          מתמקדת בקבלת רגשות ומחשבות ובמחויבות לפעולה לפי ערכים אישיים.
        </p>
      </div>

    </div>

    <!-- הגישה הטיפולית שלי -->
    <div class="mb-10">
      <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">הגישה הטיפולית שלי</h2>
      <p class="text-gray-600 leading-relaxed mb-4">
        אני מאמין שטיפול לא חייב להתקיים רק בין ארבעה קירות — אלא יכול לשלב גם שמחה, יצירה וחוויות חיים שלעתים נדחקות לשוליים ביומיום שלנו.
      </p>
      <p class="text-gray-600 leading-relaxed">
        הגעתי לעולם הטיפול אחרי שנים בהיי-טק, ומתוך ניסיון שהראה לי עד כמה מתודולוגיות ברורות יכולות להתרחב כשהן פוגשות מרחב גמיש ואנושי.
      </p>
    </div>

    <!-- לאיזה מצבים -->
    <div class="rounded-xl bg-white border border-gray-100 p-5 mb-10">
      <h2 class="text-base font-bold text-gray-800 mb-3">לאיזה מצבים התהליך מתאים?</h2>
      <div class="flex flex-wrap gap-2">
        {['חרדות', 'דכדוך', 'לחץ מתמשך', 'בלבול', 'תקיעות', 'קושי בקבלת החלטות', 'כעס', 'מחשבות טורדניות', 'התפתחות אישית'].map(tag => (
          <span class="text-xs text-gray-600 bg-gray-100 rounded-full px-3 py-1">{tag}</span>
        ))}
      </div>
    </div>

    <!-- חשוב לדעת -->
    <div class="border border-amber-200 bg-amber-50 rounded-lg p-5 mb-10 text-sm text-amber-800">
      <p class="font-semibold mb-2">חשוב לדעת</p>
      <ul class="space-y-1.5">
        <li>• איני פסיכולוג ואינני מוסמך לבצע אבחונים קליניים</li>
        <li>• הטיפול מיועד לבגירים בלבד</li>
        <li>• הטיפול אינו מיועד לדיכאון מג'ורי, PTSD, OCD, הפרעת אישיות גבולית</li>
        <li>• הטיפול אינו מהווה תחליף להמלצות רפואיות</li>
      </ul>
    </div>

    <!-- מה אני מציע -->
    <h2 class="text-xl font-bold text-gray-800 mb-4 text-center">מה אני מציע</h2>
    <ul class="space-y-3 mb-10">
      {[
        'תהליך מותאם אישית, בקצב ובדרך שנכונה לכם',
        'הגדרת מטרות אישיות ומדידות + חקירה מעמיקה של דפוסים מעכבים',
        'חיבור לעולמות של יצירה, גמישות מחשבתית ותחושת מסוגלות',
        'מרחב בטוח, מקצועי ואנושי',
        'מפגשים פרונטליים בגני תקווה או באונליין',
      ].map(item => (
        <li class="flex items-start gap-3">
          <span class="font-bold mt-0.5 shrink-0" style="color:#5ba4a4">✓</span>
          <span class="text-gray-700 text-sm">{item}</span>
        </li>
      ))}
    </ul>

    <!-- תמונת קליניקה -->
    <div class="mb-10 rounded-xl overflow-hidden shadow-sm">
      <img
        src="/images/home/clinic.png"
        alt="קליניקה של מושיקו לוי"
        class="w-full object-cover"
        style="max-height: 340px; object-position: center;"
        loading="lazy"
      />
    </div>

    <p class="text-center text-gray-500 mb-6 text-sm">צרו קשר לשיחת ייעוץ בחינם</p>

    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a
        href="/contact"
        class="inline-block text-white font-medium px-8 py-3 rounded-full transition-colors text-center"
        style="background-color: #5ba4a4;"
        onmouseover="this.style.backgroundColor='#4a8a8a'"
        onmouseout="this.style.backgroundColor='#5ba4a4'"
      >
        צור קשר
      </a>
      <a
        href="/articles"
        class="inline-block border text-sm font-medium px-8 py-3 rounded-full transition-colors text-gray-600 hover:text-[#5ba4a4] border-gray-300 hover:border-[#5ba4a4] text-center"
      >
        מאמרים
      </a>
    </div>
  </section>

</BaseLayout>
